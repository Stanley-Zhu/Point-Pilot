# Copy to .env (gitignored). Values match docker/postgres-init.sql for local dev.
# 127.0.0.1, not localhost: Windows tries IPv6 ::1 first, which Docker doesn't forward, and the connection hangs.
DATABASE_URL=postgresql+psycopg://pointpilot_admin:admin_dev@127.0.0.1:5432/pointpilot?connect_timeout=5
MIGRATION_DATABASE_URL=postgresql+psycopg://pointpilot_owner:owner_dev@127.0.0.1:5432/pointpilot?connect_timeout=5

# pytest only: the same roles against pointpilot_test, which the tests migrate and use.
TEST_DATABASE_URL=postgresql+psycopg://pointpilot_admin:admin_dev@127.0.0.1:5432/pointpilot_test?connect_timeout=5
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://pointpilot_owner:owner_dev@127.0.0.1:5432/pointpilot_test?connect_timeout=5
